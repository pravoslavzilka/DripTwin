# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Format: NAME=value (no quotes needed, no "Name: value").

# Claude agent (one of these). Without it the dashboard gives scripted status replies.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# Optional fallback agent if there is no Anthropic key
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Cartesia voice (speech-to-text and text-to-speech)
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# CARTESIA_TTS_MODEL=
# CARTESIA_ALARM_EMOTION=
# CARTESIA_PRONUNCIATION_DICT_ID=

# Tiger Data / TimescaleDB infusion log. Without it the log goes to local SQLite.
DATABASE_URL=
# Read-only role for the agent's queries (python -m driptwin.timeseries agent-role writes it)
AGENT_DATABASE_URL=
